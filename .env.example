# 环境变量配置文件
# 复制此文件为 .env.local 并填入实际值

# 文件上传目录
# 这是音乐文件存储的根目录
UPLOAD_DIR=./uploads

# 认证令牌
# 用于API访问认证的令牌，建议使用强密码
AUTH_TOKEN=your-secure-auth-token-here

# 运行环境
# 可选值：development, production, test
NODE_ENV=development

# 单个文件最大大小 (MB)
# 服务端与前端都需要（前端使用 NEXT_PUBLIC_ 前缀）
MAX_FILE_SIZE_MB=100
NEXT_PUBLIC_MAX_FILE_SIZE_MB=500
